# MAISON INTELLIGENCE — environment template (TASK-001)
#
# Copy to .env (git-ignored) or export the variables in your shell.
# Never commit real credentials. This template contains placeholders only.
#
# Toolchain recorded by TASK-001:
#   Node.js v22.22.2 / npm 11.6.2  (see package.json "engines")
#   CPython 3.12.1                (see backend/pyproject.toml requires-python)

# --- Backend: FastAPI (backend/app/main.py) ---
# Runtime profile; invalid values fail fast at startup with a clear error.
MAISON_ENV=development
# Comma-separated browser origins allowed to call the API (no trailing slash).
MAISON_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Web: Next.js (apps/web) ---
# Public API base for browser-side code. No business calls exist in TASK-001;
# later tasks must read this value instead of hard-coding the URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Reserved for later milestones (not read by TASK-001 code) ---
# MAISON_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/maison
# MAISON_PROVIDER_API_KEY=
